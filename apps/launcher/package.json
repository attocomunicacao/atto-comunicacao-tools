{
  "name": "@atto/launcher",
  "private": true,
  "version": "0.5.0",
  "description": "Launcher do ATTO Tools: instala e atualiza o app",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test src/main/atualizador.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "instalador": "electron-vite build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@types/node": "^26.6.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "author": "Atto Comunicação"
}
